# =============================================================================
# be/ — biến môi trường mẫu. Sao chép thành .env rồi điền giá trị:
#   cp .env.example .env
# =============================================================================

# ===== Server =====
NODE_ENV=development
PORT=4000
# Mức log: info (mặc định) | debug | warn | error
LOG_LEVEL=info
# Website gọi API qua chính tên miền của nó (Next chuyển tiếp) → backend TỰ NHẬN, không cần khai tên miền deploy.
# Chỉ điền khi có tên miền KHÁC gọi thẳng API (cách nhau bằng dấu phẩy). Có thể bỏ trống.
CORS_ORIGINS=

# ===== MongoDB Atlas =====
# Atlas → Database → Connect → Drivers → copy chuỗi kết nối (thay <db_password>)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app>
MONGODB_DB_NAME=mayqueen

# ===== Cloudinary =====
# Cloudinary Console → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục gốc chứa ảnh upload trên Cloudinary
CLOUDINARY_FOLDER=mayqueen

# ===== Bảo mật / giới hạn =====
# Số proxy tin cậy phía trước — QUAN TRỌNG cho rate limit (nhận diện khách theo IP):
#   - Chạy local (Next.js rewrite → backend): 1
#   - Production Vercel → Render: 2 (Vercel rewrite + bộ cân bằng tải của Render)
# Đặt thiếu → mọi khách bị coi là cùng 1 IP (IP của Vercel) → form tư vấn / đặt hàng chặn nhầm người thật.
# Đặt thừa → kẻ xấu giả header X-Forwarded-For để né giới hạn.
TRUST_PROXY=1
# "Khóa cửa sau" — mã bí mật CHUNG với frontend (đặt CÙNG giá trị ở Vercel, biến PROXY_SECRET).
# Có giá trị → backend chỉ nhận request đi qua website (Vercel gắn header X-Proxy-Secret); gọi thẳng
# *.onrender.com bị chặn 403 (trừ /api/v1/health) → không ai giả được X-Forwarded-For để né giới hạn.
# Tạo: npm run secret. Máy dev: bỏ trống (tắt).
PROXY_SECRET=

# ===== Email thông báo cho admin (đơn hàng mới, yêu cầu tư vấn mới) — Resend =====
# Vì sao Resend (API qua HTTPS) mà không dùng SMTP/Gmail: Render gói Free CHẶN cổng SMTP 25/465/587.
# 1) Tạo tài khoản https://resend.com → API Keys → Create API Key (quyền "Sending access") → dán vào dưới.
# 2) Người gửi (MAIL_FROM):
#    - Chưa có tên miền riêng: giữ "onboarding@resend.dev" — Resend CHỈ cho gửi tới email đã đăng ký tài khoản
#      Resend → đăng ký Resend bằng chính email nhận thông báo (VD marketingbotvn@gmail.com).
#    - Có tên miền (VD mayqueenslim.com): Resend → Domains → thêm tên miền + bản ghi DNS → đổi thành
#      "Mayqueen Slim <thongbao@mayqueenslim.com>" để gửi tới nhiều người nhận bất kỳ.
# 3) ADMIN_NOTIFY_EMAILS: người nhận, nhiều người cách nhau dấu phẩy.
# 4) PUBLIC_SITE_URL: địa chỉ website (nút "Mở trong trang quản trị" trong email).
# Để trống RESEND_API_KEY → tắt gửi mail (website vẫn chạy bình thường).
# Gửi thử: npm run mail:test   ·   Xem trước mẫu (không cần key): npm run mail:test -- --preview
RESEND_API_KEY=
MAIL_FROM=Mayqueen Slim <onboarding@resend.dev>
ADMIN_NOTIFY_EMAILS=
PUBLIC_SITE_URL=https://mayqueen-slim.vercel.app
# Giới hạn chung mỗi IP: số request / cửa sổ thời gian (ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ===== Đăng nhập quản trị (JWT trong cookie HttpOnly) =====
# Tạo 2 secret ngẫu nhiên: npm run secret  (>= 32 ký tự, 2 secret phải khác nhau)
# Bỏ trống khi dev → tự sinh mỗi lần chạy (khởi động lại phải đăng nhập lại)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Thời hạn token: s | m | h | d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Số thiết bị đăng nhập cùng lúc tối đa (vượt → phiên cũ nhất bị đăng xuất)
MAX_SESSIONS=10
# Cookie chỉ gửi qua HTTPS — mặc định bật ở production
# COOKIE_SECURE=true

# Tài khoản quản trị (đổi ID / mật khẩu → mọi phiên đăng nhập cũ bị đăng xuất)
# Production: mật khẩu tối thiểu 12 ký tự
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

