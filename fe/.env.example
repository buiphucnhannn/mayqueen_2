# =============================================================================
# fe/ — biến môi trường mẫu. Sao chép thành .env.local rồi điền giá trị:
#   cp .env.example .env.local
# Biến NEXT_PUBLIC_* được đưa ra trình duyệt → KHÔNG đặt key bí mật ở đây.
# Hosting cPanel: KHÔNG dùng file này — khai báo trong Setup Node.js App → Environment variables
# (xem docs/HUONG-DAN-DEPLOY-HOSTING.md).
# =============================================================================

# URL chính thức của site (SEO, sitemap, Open Graph) — máy dev bỏ trống (= http://localhost:3000).
# Production: https://mayqueenslim.com (cả 2 site dùng chung để Google chỉ lập chỉ mục 1 tên miền).
# NEXT_PUBLIC_SITE_URL=https://mayqueenslim.com

# Địa chỉ backend (thư mục be/) — CHỈ server Next.js dùng để chuyển tiếp /api/v1/*.
# Máy dev: bỏ trống = http://localhost:4000. Production: BẮT BUỘC (VD https://api.mayqueenslim.com).
# Trình duyệt luôn gọi /api/v1 cùng tên miền → cookie đăng nhập an toàn (SameSite=Strict).
BACKEND_URL=http://localhost:4000

# Mã bí mật chung với backend (CÙNG giá trị PROXY_SECRET trong .env của backend). Next gắn vào mọi request
# gửi sang backend (header X-Proxy-Secret) → backend từ chối ai gọi thẳng, không qua website.
# KHÔNG thêm tiền tố NEXT_PUBLIC_ (chỉ server dùng). Máy dev: bỏ trống.
# PROXY_SECRET=

# Chỉ dùng khi chạy 2 tên miền (mỗi tên miền 1 bộ máy riêng):
# SITE_ORIGIN=https://mayqueen.vn      # tên miền của CHÍNH site này
# PEER_SITES=https://mayqueenslim.com  # site anh em → admin lưu ở đây thì site kia cũng xoá cache
